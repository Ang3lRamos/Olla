# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local a git.

# Supabase: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publicable (sb_publishable_...). Es segura en el navegador porque la RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Contraseña de la base de datos (Project Settings -> Database). Solo la usa el CLI para aplicar
# migraciones, semilla y tipos (npm run db:push / db:types); la app nunca la lee.
SUPABASE_DB_PASSWORD=
# Llave secreta (sb_secret_..., o la antigua service_role). Solo en el servidor: activa el plan
# cuando Wompi confirma un pago, que llega sin sesión de usuario. Nunca con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Pooler de conexiones (Connect -> Session pooler), p. ej. aws-0-us-east-1.pooler.supabase.com
SUPABASE_POOLER_HOST=

# Asistente de IA: cualquier API compatible con OpenAI (/v1/chat/completions).
# - OmniRoute local: http://localhost:20128/v1 (AI_MODEL puede ser "auto/smart" o el nombre de un combo).
# - "mock": asistente simulado por reglas, sin proveedor (desarrollo y demos).
# - Groq: https://api.groq.com/openai/v1
# AI_MODEL admite varios modelos separados por coma, en orden de preferencia: si uno se queda
# sin cupo, falla o tarda, se usa el siguiente (p. ej. openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b).
# Sin AI_BASE_URL (o sin AI_MODEL fuera de "mock") el asistente se muestra como no disponible.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Opcionales.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Con los gpt-oss de Groq, "low" responde en 1-2 s y gasta la mitad del cupo (sin él tardan ~20 s).
# Si un modelo no acepta estos ajustes, la consulta se repite sin ellos.
AI_REASONING_EFFORT=
AI_MAX_TOKENS=

# Pagos con Wompi (comercios.wompi.co -> Desarrolladores). En desarrollo, las de pruebas
# (pub_test_, prv_test_, test_events_, test_integrity_); en producción, las prod_.
# Wompi no acepta volver a localhost: el pago completo se prueba en un despliegue.
# URL de eventos para configurar en Wompi: https://<tu-dominio>/api/wompi/eventos
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# Responsable de Olla, para los textos legales (Ley 1480, art. 50: identidad, dirección, teléfono
# y correo). Son públicos en /terminos, /privacidad y /reembolsos; sin ellos el build falla.
LEGAL_OWNER_NAME=
LEGAL_OWNER_ID=
LEGAL_OWNER_ADDRESS=
LEGAL_OWNER_PHONE=
LEGAL_CONTACT_EMAIL=

# Correos con acceso al panel /admin, separados por coma. Vacío = nadie entra. Necesita también
# SUPABASE_SECRET_KEY, porque el panel lee los datos de todos los hogares.
ADMIN_EMAILS=

# Correos de Olla a soporte (p. ej. "reembolso pedido") con Resend. Sin dominio propio, Resend
# solo envía desde onboarding@resend.dev al correo de la cuenta: créala con LEGAL_CONTACT_EMAIL.
# Con dominio verificado, EMAIL_FROM pasa a ser algo como "Olla <soporte@tudominio.co>".
RESEND_API_KEY=
EMAIL_FROM=

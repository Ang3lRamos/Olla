# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local a git.

# Supabase: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publicable (sb_publishable_...). Es segura en el navegador porque la RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...). Solo la usan los scripts locales (semilla); nunca se expone al navegador.
SUPABASE_SECRET_KEY=

# Asistente de IA: cualquier API compatible con OpenAI (/v1/chat/completions).
# En desarrollo: OmniRoute local, p. ej. http://localhost:20128/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Opcionales.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

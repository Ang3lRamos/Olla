# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local a git.

# Supabase: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publicable (sb_publishable_...). Es segura en el navegador porque la RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Contraseña de la base de datos (Project Settings -> Database). Solo la usa el CLI para aplicar
# migraciones, semilla y tipos (npm run db:push / db:types); la app nunca la lee.
SUPABASE_DB_PASSWORD=
# Pooler de conexiones (Connect -> Session pooler), p. ej. aws-0-us-east-1.pooler.supabase.com
SUPABASE_POOLER_HOST=

# Asistente de IA: cualquier API compatible con OpenAI (/v1/chat/completions).
# En desarrollo: OmniRoute local, p. ej. http://localhost:20128/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Opcionales.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Cuenta para pruebas de punta a punta en local (scripts de Playwright). Se crea con la app y se
# confirma a mano en la base; no se usa en producción.
E2E_EMAIL=
E2E_PASSWORD=
